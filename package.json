{
  "name": "ffhub-frontend-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "dev": "vp run -r dev",
    "lint": "vp run -r lint",
    "lint:fix": "vp run -r lint:fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "portless": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-tailwind-legacy": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
